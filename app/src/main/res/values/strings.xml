    <!-- Pet scene captions, in the pets' voice: Sunny is the dog, Misty the cat. One is picked per day. -->
    <string-array name="pet_caption_sunny">
        <item>Perfect walkies weather! Off we go.</item>
        <item>Misty has claimed the sunniest windowsill.</item>
        <item>Sunshine and tail wags all round.</item>
    </string-array>
    <string-array name="pet_caption_cloudy">
        <item>A bit grey, but Sunny is still keen for a walk.</item>
        <item>Nap weather, says Misty.</item>
        <item>No sun, no problem. Still time for a stroll.</item>
    </string-array>
    <string-array name="pet_caption_rain">
        <item>Sunny wants puddles. Misty wants a towel.</item>
        <item>Grab a raincoat. Misty is NOT going out in this.</item>
        <item>Wet paws ahead. Keep a towel by the door.</item>
    </string-array>
    <string-array name="pet_caption_storm">
        <item>Thunder! Misty is under the bed. Keep pets inside.</item>
        <item>Stormy out there. Sofa cuddles today.</item>
    </string-array>
    <string-array name="pet_caption_snow">
        <item>Snow zoomies, then straight back to the blanket.</item>
        <item>Wipe those paws when you come in.</item>
    </string-array>
    <string-array name="pet_caption_hot">
        <item>Too hot for long walks. Plenty of water today.</item>
        <item>Fresh water bowls today. It is a scorcher.</item>
    </string-array>
    <string-array name="pet_caption_cold">
        <item>Brrr. Short walks and warm blankets.</item>
        <item>Coat weather for small dogs today.</item>
    </string-array>
    <!-- Night is split by the city's local hour, so a 3 AM caption doesn't suggest an evening stroll. -->
    <string-array name="pet_caption_night_evening">
        <item>Quiet night. Time for one last stroll before bed?</item>
        <item>Sunny thinks there\'s time for one more lap of the block.</item>
    </string-array>
    <string-array name="pet_caption_night_late">
        <item>Sunny and Misty are curled up asleep.</item>
        <item>Lights out. Misty has claimed the warm spot.</item>
    </string-array>
    <string-array name="pet_caption_night_before_dawn">
        <item>Still dark out. Sunny is already waiting by the door.</item>
        <item>Too dark to get up, says Misty. She\'s pretending to be asleep.</item>
    </string-array>
